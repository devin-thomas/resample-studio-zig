{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resample linked varispeed entry v1",
  "type": "object",
  "required": ["id", "language", "contract", "cwd", "build", "run", "outputProfile", "dependencies", "improvements"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "language": {"type": "string", "minLength": 1},
    "contract": {"const": "resample-linked-v1"},
    "cwd": {"type": "string", "minLength": 1},
    "build": {"$ref": "#/$defs/argv"},
    "run": {"$ref": "#/$defs/argv"},
    "outputProfile": {"enum": ["zig-48k", "node-44k-float"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "improvements": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
